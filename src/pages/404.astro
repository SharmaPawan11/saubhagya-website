---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.vue';
import Footer from '@/components/Footer.vue';
---

<BaseLayout title="404 – Record Not Found | Saubhagya Mishra & Associates">
  <div class="not-found-layout">
    <Navbar client:load />
    <main class="not-found-main">
      <div class="not-found-container">
        <span class="not-found-badge">404 ERROR</span>
        <h1 class="not-found-heading">Record Not Found</h1>
        <p class="not-found-text">
          The judicial brief or procedural record you requested does not exist or has been relocated within chambers.
        </p>
        <a href="/" class="not-found-btn">
          RETURN TO CHAMBERS
        </a>
      </div>
    </main>
    <Footer client:load />
  </div>
</BaseLayout>

<style>
  .not-found-layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
  }
  .not-found-main {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 1.5rem 5rem;
    text-align: center;
  }
  .not-found-container {
    max-width: 36rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .not-found-badge {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-secondary);
    text-transform: uppercase;
    border: 1px solid rgba(129, 85, 36, 0.4);
    border-radius: var(--radius-full);
    padding: 0.35rem 1rem;
    font-weight: 700;
  }
  .not-found-heading {
    font-family: var(--font-headline);
    font-size: 2.75rem;
    color: var(--color-primary);
    line-height: 1.15;
    font-weight: 600;
  }
  .not-found-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }
  .not-found-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 2rem;
    background-color: var(--color-primary-container);
    color: var(--color-on-primary);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: background-color 0.2s ease;
  }
  .not-found-btn:hover {
    background-color: var(--color-primary);
  }
</style>
